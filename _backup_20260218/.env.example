# ============================================
# 명심코칭 앱 환경 변수 설정
# ============================================
# 
# 보안 주의사항:
# 1. 이 파일을 .env로 복사하여 실제 값을 입력하세요
# 2. .env 파일은 절대 Git에 커밋하지 마세요
# 3. API 키는 정기적으로 로테이션하세요
# 4. 프로덕션 환경에서는 Vercel 환경 변수를 사용하세요
#
# ============================================

# --------------------------------------------
# Google AI (Gemini) API
# --------------------------------------------
# 발급: https://makersuite.google.com/app/apikey
# 권장: IP 제한 설정, 사용량 모니터링
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# --------------------------------------------
# Google Cloud TTS (Text-to-Speech)
# --------------------------------------------
# 발급: https://console.cloud.google.com/apis/credentials
# JSON 키 파일 내용을 한 줄로 변환하여 입력
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# --------------------------------------------
# Supabase
# --------------------------------------------
# 프로젝트: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --------------------------------------------
# PayPal (Optional)
# --------------------------------------------
# 발급: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# --------------------------------------------
# 보안 설정
# --------------------------------------------
# 프로덕션 환경에서는 'production'으로 설정
NODE_ENV=development

# Rate Limiting (선택사항)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=60000

# ============================================
# 보안 체크리스트
# ============================================
# 
# [ ] .env 파일이 .gitignore에 포함되어 있는지 확인
# [ ] API 키에 IP 제한 설정
# [ ] API 키 사용량 모니터링 설정
# [ ] 정기적인 키 로테이션 일정 수립
# [ ] Vercel 환경 변수에 프로덕션 키 설정
# [ ] 개발/스테이징/프로덕션 환경별 키 분리
#
# ============================================
